rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is admin or owner
    function isAdminOrOwner(userId) {
      return isAdmin() || isOwner(userId);
    }

    // ==================== USERS ====================
    match /users/{userId} {
      // Anyone authenticated can read their own profile
      // Admins can read all profiles
      allow read: if isAdminOrOwner(userId);
      
      // Only admins can create users
      allow create: if isAdmin();
      
      // Users can update their own profile, admins can update any
      allow update: if isAdminOrOwner(userId);
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // ==================== EMPLOYEES ====================
    match /employees/{employeeId} {
      // Admins can do everything
      // Farmers can only read their own data
      allow read: if isAdmin() || 
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // ==================== PAYROLL ====================
    match /payroll/{payrollId} {
      // Admins can do everything
      // Farmers can only read their own payroll
      allow read: if isAdmin() || 
        (isAuthenticated() && resource.data.farmerId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // ==================== BONUS/DEDUCTIONS ====================
    match /bonusDeductions/{bdId} {
      // Admins can do everything
      // Farmers can read their own bonus/deductions
      allow read: if isAdmin() || 
        (isAuthenticated() && resource.data.farmerId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // ==================== PAY PERIODS ====================
    match /payPeriods/{periodId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // Only admins can modify
      allow create, update, delete: if isAdmin();
    }

    // ==================== NOTIFICATIONS ====================
    match /notifications/{notificationId} {
      // All authenticated users can read notifications
      allow read: if isAuthenticated();
      // Admins can create and modify
      allow create, update: if isAdmin();
      // Admins can delete, users can acknowledge their own
      allow delete: if isAdmin();
    }

    // ==================== DISPUTES ====================
    match /disputes/{disputeId} {
      // Admins can do everything
      // Farmers can read and create disputes for themselves
      allow read: if isAdmin() || 
        (isAuthenticated() && resource.data.farmerId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ==================== TREE CONTAINERS ====================
    match /treeContainers/{treeId} {
      // All authenticated users can read
      allow read: if isAuthenticated();
      // Only admins can modify
      allow create, update, delete: if isAdmin();
    }

    // ==================== HARVEST ====================
    match /harvest/{harvestId} {
      // Admins can do everything
      // Farmers can read their own and create new records
      allow read: if isAdmin() || 
        (isAuthenticated() && resource.data.farmerId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ==================== SETTINGS ====================
    match /settings/{settingId} {
      // All authenticated users can read settings
      allow read: if isAuthenticated();
      // Only admins can modify settings
      allow create, update, delete: if isAdmin();
    }
  }
}
